# Database Connection (MongoDB via Prisma)
# Local development: a single-node replica set is recommended so Prisma transactions
# (used by some write paths) are available:
#   docker run -d -p 27017:27017 --name sidenote-mongo mongo:7 --replSet rs0
#   docker exec -it sidenote-mongo mongosh --eval "rs.initiate()"
DATABASE_URL="mongodb://localhost:27017/sidenote_subscriptions?replicaSet=rs0&serverSelectionTimeoutMS=2000&connectTimeoutMS=2000"

# Better Auth Configuration (REQUIRED)
# Generate a unique value per environment, e.g. `openssl rand -base64 48`.
# The app refuses to start without a secret of at least 32 characters.
BETTER_AUTH_SECRET=""
# Must match the origin the app is served from. Required in production.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" to allow the demo catalog (products, categories, coupons, CMS)
# to be auto-seeded when the database is empty. Ignored in development, where
# seeding is always allowed. User accounts are never seeded automatically.
SEED_DEMO_DATA="false"

# Gemini API (Optional)
GEMINI_API_KEY=""
