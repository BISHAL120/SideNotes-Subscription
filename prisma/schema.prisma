datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Better Auth Authentication Models
// -------------------------------------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "user" | "admin"
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -------------------------------------------------------------
// Digital eCommerce & Catalog Models
// -------------------------------------------------------------

model Product {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String   @unique
  brand            String   // Publisher, Vendor, or Studio
  price            Float
  originalPrice    Float?
  rating           Float    @default(5.0)
  reviewCount      Int      @default(0)
  category         String
  subcategory      String?
  images           String[]
  stock            Int      @default(999)
  isHotDeal        Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  isTopSelling     Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  discountBadge    String?

  // Digital product delivery & license metadata
  digitalAssetType String   @default("SUBSCRIPTION") // "SUBSCRIPTION" | "LICENSE_KEY" | "SOURCE_CODE" | "UI_KIT" | "EBOOK"
  downloadUrl      String?  // Download link or access URL
  fileFormat       String?  // e.g. "ZIP / Next.js Source", "Figma File", "PDF Guide", "Activation Code"
  fileSize         String?  // e.g. "24 MB", "Cloud Repo", "Instant Key"
  version          String?  // e.g. "v2.5.0", "2026 Edition"
  liveDemoUrl      String?  // e.g. "https://preview.sidenote.app"
  licenseType      String?  @default("Lifetime License") // "Personal", "Commercial", "Subscription"
  licenseKeysPool  String[] // Pool of unassigned license keys

  description      String
  specifications   String?  // JSON string
  keyFeatures      String[]
  tags             String[]
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, active])
  @@index([active, createdAt])
  @@map("products")
}

model Category {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String   @unique
  iconName      String   @default("Sparkles")
  itemCount     Int      @default(0)
  description   String?
  subcategories String?  // JSON string of { name: string, slug: string }[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("categories")
}

model Order {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber          String   @unique
  userId               String?
  customerName         String
  customerEmail        String
  customerPhone        String
  company              String?
  notes                String?
  couponCode           String?
  items                String   // JSON string of CartItem array
  subtotal             Float
  discount             Float    @default(0)
  total                Float
  paymentMethod        String   // "bkash" | "card" | "cod" | "nagad"
  paymentStatus        String   @default("PAID") // "PAID" | "PENDING" | "FAILED"
  orderStatus          String   @default("COMPLETED") // "COMPLETED" | "PROCESSING" | "REFUNDED" | "CANCELLED"
  licenseKeysDelivered String[] // License keys assigned to the customer
  downloadLinks        String[] // Instant direct download URLs
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([createdAt])
  @@map("orders")
}

model Coupon {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  code            String    @unique
  discountAmount  Float?
  discountPercent Float?
  minSpend        Float     @default(0)
  description     String
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("coupons")
}

// -------------------------------------------------------------
// Website Content Management System (CMS) Model
// -------------------------------------------------------------

model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // e.g. "cms_all", "hero_carousel", "trust_benefits", "announcement_bar", "footer_info", "policies"
  data      String   // JSON string storing the content configuration
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model Review {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  productId        String
  userName         String
  userEmail        String?
  rating           Float
  comment          String
  verifiedPurchase Boolean  @default(true)
  status           String   @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  createdAt        DateTime @default(now())

  @@map("reviews")
}
